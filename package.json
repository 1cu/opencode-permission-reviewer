{
  "name": "opencode-permission-reviewer",
  "version": "0.8.0",
  "description": "Policy-aware permission reviewer for OpenCode V1",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "bin": {
    "opencode-permission-reviewer": "./dist/explain.js"
  },
  "license": "Apache-2.0",
  "author": "Warc0s",
  "homepage": "https://github.com/Warc0s/opencode-permission-reviewer",
  "repository": {
    "type": "git",
    "url": "https://github.com/Warc0s/opencode-permission-reviewer.git"
  },
  "bugs": {
    "url": "https://github.com/Warc0s/opencode-permission-reviewer/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai-agent",
    "agent-safety",
    "auto-approval",
    "permission-management",
    "llm",
    "codex-guardian",
    "policy-as-code",
    "typescript",
    "bun"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "opencode": ">=1.18.11 <2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.11 <2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.11",
    "@types/bun": "^1.3.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "bun test",
    "test:stress": "bun test tests/stress.test.ts --timeout 30000",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "1.9.12"
  }
}
